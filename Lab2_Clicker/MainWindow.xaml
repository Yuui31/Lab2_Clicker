<Window x:Class="Lab2_Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_Clicker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="10">
            <Button x:Name="TestBtn" Content="Тест BigNumber" Margin="5" Padding="10,5" Click="TestBtn_Click"/>
            <Button x:Name="TestPlayerBtn" Content="Тест Player" Margin="5" Padding="10,5" Click="TestPlayerBtn_Click"/>
            <Button x:Name="TestEnemyBtn" Content="Тест Enemy" Margin="5" Padding="10,5" Click="TestEnemyBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
