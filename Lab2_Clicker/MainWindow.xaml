<Window x:Class="Lab2_Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_Clicker"
        mc:Ignorable="d"
        Title="⚔️ Clicker of Shadows" 
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Window.Resources>
        <!-- Стиль для текстовых подписей -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9A66B"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>

        <!-- Стиль для значений (крупный текст) -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0E5D0"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="FantasyButton" TargetType="Button">
            <Setter Property="Background" Value="#2A1E14"/>
            <Setter Property="Foreground" Value="#F0E5D0"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#8B6B3D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A3524"/>
                    <Setter Property="BorderBrush" Value="#C9A66B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Фон: картинка с затемнением через overlay -->
    <Grid x:Name="MainGrid">
        <!-- Слой 1: картинка фона -->
        <Image Source="/Background/bg.png" 
               Stretch="UniformToFill"
               Opacity="0.35"/>

        <!-- Слой 2: чёрный градиент сверху для затемнения краёв -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0.4"/>
                    <GradientStop Color="#00000000" Offset="0.7"/>
                    <GradientStop Color="#CC000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Слой 3: контент -->
        <Grid Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <!-- ЛЕВО: игрок -->
                <ColumnDefinition Width="*"/>
                <!-- ЦЕНТР: враг -->
                <ColumnDefinition Width="280"/>
                <!-- ПРАВО: улучшения -->
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ: Игрок -->
            <Border Grid.Column="0" 
                    Background="#99000000" 
                    BorderBrush="#8B6B3D" 
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ГЕРОЙ" 
                               FontFamily="Georgia" FontSize="20" FontWeight="Bold"
                               Foreground="#C9A66B" HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Уровень:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="LevelText" Text="1" Style="{StaticResource ValueStyle}"/>
                    
                    <TextBlock Text="Урон за удар:" Style="{StaticResource LabelStyle}" Margin="0,20,0,2"/>
                    <TextBlock x:Name="DamageText" Text="1" 
                               Style="{StaticResource ValueStyle}"
                               Foreground="#FF6B6B"/>
                    <TextBlock Text="Золото:" Style="{StaticResource LabelStyle}" Margin="0,20,0,2"/>
                    <TextBlock x:Name="GoldText" Text="0" 
                               Style="{StaticResource ValueStyle}"
                               Foreground="#FFD700"/>



                    <Button x:Name="UpgradeButton" 
                            Content="Улучшить урон"
                            Style="{StaticResource FantasyButton}"
                            Margin="0,30,0,0"
                            Click="UpgradeButton_Click"/>

                    <TextBlock x:Name="UpgradeCostText" 
                               Text="Стоимость: 10"
                               FontFamily="Georgia" FontSize="12"
                               Foreground="#8B6B3D"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <!-- НОВАЯ КНОПКА: Улучшение перезарядки -->
                    <Button x:Name="CooldownUpgradeButton" Content="⚡ Ускорить удар" 
        Style="{StaticResource FantasyButton}"
        Margin="0,15,0,0"
        Click="CooldownUpgradeButton_Click"/>
                    <TextBlock x:Name="CooldownCostText" Text="Стоимость: 50"
           FontFamily="Georgia" FontSize="12"
           Foreground="#8B6B3D"
           HorizontalAlignment="Center"
           Margin="0,5,0,0"/>

                    <TextBlock x:Name="CooldownInfoText" Text="КД: 0.5с"
           FontFamily="Georgia" FontSize="12"
           Foreground="#8B6B3D"
           HorizontalAlignment="Center"
           Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- ЦЕНТР: Противник -->
            <Grid Grid.Column="1" Margin="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="EnemyNameText" 
                               Text="Противник"
                               FontFamily="Georgia" FontSize="28" FontWeight="Bold"
                               Foreground="#C9A66B"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Иконка врага — клик по ней -->
                    <Border BorderBrush="#8B6B3D" 
                            BorderThickness="3"
                            CornerRadius="15"
                            Background="#33000000"
                            Padding="20"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonDown="EnemyIcon_Click">
                        <Image x:Name="EnemyIcon" 
                               Width="200" Height="200"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- HP -->
                    <TextBlock Text="Здоровье:" 
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,5"/>
                    <TextBlock x:Name="EnemyHpText" 
                               Text="0 / 0"
                               Style="{StaticResource ValueStyle}"
                               Foreground="#FF6B6B"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Награда:" 
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,5"/>
                    <TextBlock x:Name="EnemyRewardText" 
                               Text="0"
                               Style="{StaticResource ValueStyle}"
                               Foreground="#FFD700"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Кликни по монстру, чтобы атаковать"
                               FontFamily="Georgia" FontSize="12"
                               Foreground="#8B6B3D"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ПРАВАЯ ПАНЕЛЬ: Статистика -->
            <Border Grid.Column="2" 
                    Background="#99000000" 
                    BorderBrush="#8B6B3D" 
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ХРОНИКИ" 
                               FontFamily="Georgia" FontSize="20" FontWeight="Bold"
                               Foreground="#C9A66B" HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Убито противников:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock x:Name="KilledText" Text="0" 
                               Style="{StaticResource ValueStyle}"
                               Foreground="#7FBF7F"/>

                    <TextBlock Text="Всего нанесено урона:" Style="{StaticResource LabelStyle}" Margin="0,20,0,2"/>
                    <TextBlock x:Name="TotalDamageText" Text="0" 
                               Style="{StaticResource ValueStyle}"
                               Foreground="#FF6B6B"/>

                    <TextBlock Text="Заработано золота:" Style="{StaticResource LabelStyle}" Margin="0,20,0,2"/>
                    <TextBlock x:Name="TotalGoldText" Text="0" 
                               Style="{StaticResource ValueStyle}"
                               Foreground="#FFD700"/>

                    <Separator Margin="0,30,0,20" Background="#8B6B3D" Height="1"/>

                    <TextBlock Text="Следующий противник"
                               FontFamily="Georgia" FontSize="12"
                               Foreground="#8B6B3D"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>